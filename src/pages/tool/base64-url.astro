---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Base64 / URL 编解码器" description="Base64、URL 编码/解码，双向转换，纯本地处理">
  <h1 class="section-title" style="font-size: 1.75rem;">Base64 / URL 编解码器</h1>
  <p style="color: var(--muted); margin: 0 0 2rem;">
    Base64 和 URL 编码/解码，双向转换，复制即用。Made by Qingniao。
  </p>

  <div class="card" style="margin-bottom: 1.25rem;">
    <div style="display: flex; gap: 1rem; flex-wrap: wrap; align-items: center; margin-bottom: 1rem;">
      <div style="display: flex; border: 1px solid var(--border); border-radius: 8px; overflow: hidden;">
        <button id="tab-base64" class="tab active" style="padding: 0.5rem 1.25rem; border: none; background: var(--accent); color: #fff; cursor: pointer; font-size: 0.95rem;">Base64</button>
        <button id="tab-url" class="tab" style="padding: 0.5rem 1.25rem; border: none; background: transparent; color: var(--fg); cursor: pointer; font-size: 0.95rem;">URL</button>
      </div>
      <span id="mode-label" style="color: var(--muted); font-size: 0.9rem;">文本 ↔ Base64</span>
    </div>

    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem;">
      <div>
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
          <label style="font-size: 0.9rem; font-weight: 600;">输入</label>
          <div style="display: flex; gap: 0.4rem;">
            <button id="swap" title="交换输入输出" style="background: var(--accent-weak); color: var(--accent); border: none; border-radius: 6px; padding: 0.25rem 0.7rem; font-size: 0.8rem; cursor: pointer;">⇄ 交换</button>
            <button id="demo-enc" style="background: var(--accent-weak); color: var(--accent); border: none; border-radius: 6px; padding: 0.25rem 0.7rem; font-size: 0.8rem; cursor: pointer;">示例</button>
          </div>
        </div>
        <textarea id="input" placeholder="输入要编码/解码的内容…" style="width: 100%; min-height: 220px; padding: 0.75rem; border: 1px solid var(--border); border-radius: 8px; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 0.85rem; resize: vertical; line-height: 1.5; box-sizing: border-box;"></textarea>
      </div>
      <div>
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
          <label style="font-size: 0.9rem; font-weight: 600;">输出</label>
          <div style="display: flex; gap: 0.4rem;">
            <button id="copy" disabled style="background: var(--accent); color: #fff; border: none; border-radius: 6px; padding: 0.25rem 0.7rem; font-size: 0.8rem; cursor: pointer;">复制</button>
            <button id="clear" style="background: transparent; color: var(--muted); border: 1px solid var(--border); border-radius: 6px; padding: 0.25rem 0.7rem; font-size: 0.8rem; cursor: pointer;">清空</button>
          </div>
        </div>
        <textarea id="output" readonly placeholder="结果在这里…" style="width: 100%; min-height: 220px; padding: 0.75rem; border: 1px solid var(--border); border-radius: 8px; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 0.85rem; resize: vertical; line-height: 1.5; box-sizing: border-box; background: #fafafa; color: var(--muted);"></textarea>
      </div>
    </div>

    <div style="display: flex; gap: 0.5rem; margin-top: 1rem; flex-wrap: wrap;">
      <button id="encode" style="background: var(--accent); color: #fff; border: none; border-radius: 8px; padding: 0.5rem 1.5rem; font-size: 0.95rem; cursor: pointer;">编码 →</button>
      <button id="decode" style="background: var(--accent-weak); color: var(--accent); border: none; border-radius: 8px; padding: 0.5rem 1.5rem; font-size: 0.95rem; cursor: pointer;">← 解码</button>
    </div>
  </div>

  <div class="card" style="color: var(--muted); font-size: 0.9rem;">
    <p style="margin: 0;"><strong style="color: var(--fg);">说明：</strong>Base64 支持 UTF-8 中文（自动转码）；URL 编码支持百分号转义（encodeURIComponent 语义）。所有处理都在本地浏览器完成，内容不会上传。</p>
  </div>
</BaseLayout>

<script>
  const input = document.getElementById('input');
  const output = document.getElementById('output');
  const modeLabel = document.getElementById('mode-label');
  const copyBtn = document.getElementById('copy');
  const clearBtn = document.getElementById('clear');
  const swapBtn = document.getElementById('swap');
  const demoBtn = document.getElementById('demo-enc');
  const encodeBtn = document.getElementById('encode');
  const decodeBtn = document.getElementById('decode');
  const tabBase64 = document.getElementById('tab-base64');
  const tabUrl = document.getElementById('tab-url');
  let mode = 'base64';

  function setMode(m) {
    mode = m;
    tabBase64.style.background = m === 'base64' ? 'var(--accent)' : 'transparent';
    tabBase64.style.color = m === 'base64' ? '#fff' : 'var(--fg)';
    tabUrl.style.background = m === 'url' ? 'var(--accent)' : 'transparent';
    tabUrl.style.color = m === 'url' ? '#fff' : 'var(--fg)';
    modeLabel.textContent = m === 'base64' ? '文本 ↔ Base64' : '文本 ↔ URL 编码';
  }

  function b64encode(s) {
    return btoa(unescape(encodeURIComponent(s)));
  }
  function b64decode(s) {
    try { return decodeURIComponent(escape(atob(s.trim()))); }
    catch { return '⚠️ 无法解码：不是有效的 Base64'; }
  }
  function urlencode(s) { return encodeURIComponent(s); }
  function urldecode(s) {
    try { return decodeURIComponent(s); }
    catch { return '⚠️ 无法解码：不是有效的 URL 编码'; }
  }

  function doEncode() {
    const v = input.value;
    if (!v) { output.value = ''; return; }
    output.value = mode === 'base64' ? b64encode(v) : urlencode(v);
    copyBtn.disabled = false;
  }
  function doDecode() {
    const v = input.value;
    if (!v) { output.value = ''; return; }
    output.value = mode === 'base64' ? b64decode(v) : urldecode(v);
    copyBtn.disabled = false;
  }

  encodeBtn.addEventListener('click', doEncode);
  decodeBtn.addEventListener('click', doDecode);
  tabBase64.addEventListener('click', () => setMode('base64'));
  tabUrl.addEventListener('click', () => setMode('url'));

  swapBtn.addEventListener('click', () => {
    const tmp = input.value;
    input.value = output.value;
    output.value = tmp;
    copyBtn.disabled = !output.value;
  });

  demoBtn.addEventListener('click', () => {
    input.value = mode === 'base64' ? '你好，青鸟。Hello, Qingniao!' : 'https://qingniao.dev/tool/?name=青鸟&v=1.0';
    doEncode();
  });

  clearBtn.addEventListener('click', () => {
    input.value = '';
    output.value = '';
    copyBtn.disabled = true;
  });

  copyBtn.addEventListener('click', () => {
    navigator.clipboard.writeText(output.value).then(() => {
      const old = copyBtn.textContent;
      copyBtn.textContent = '已复制 ✓';
      setTimeout(() => (copyBtn.textContent = old), 1200);
    });
  });
</script>

<style>
  @media (max-width: 720px) {
    [style*="grid-template-columns: 1fr 1fr"] { grid-template-columns: 1fr !important; }
  }
</style>
