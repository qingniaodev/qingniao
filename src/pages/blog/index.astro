---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout title="博客 - 青鸟（Qingniao）" description="青鸟（Qingniao）的博客文章列表">
  <h1 class="section-title" style="font-size: 1.75rem;">博客</h1>

  {
    posts.length > 0 ? (
      <div style="display: grid; gap: 1.25rem;">
        {posts.map((post) => (
          <article class="card">
            <a href={`/blog/${post.id}/`} style="font-size: 1.15rem; font-weight: 700; color: var(--fg);">
              {post.data.title}
            </a>
            <div style="color: var(--muted); font-size: 0.9rem; margin-top: 0.4rem;">
              {post.data.pubDate.toLocaleDateString('zh-CN')}
              {post.data.tags.length > 0 && ` · ${post.data.tags.join(' / ')}`}
            </div>
            {post.data.description && (
              <p style="color: var(--muted); margin: 0.6rem 0 0; font-size: 0.95rem;">
                {post.data.description}
              </p>
            )}
          </article>
        ))}
      </div>
    ) : (
      <div class="card"><p style="color: var(--muted); margin: 0;">还没有文章，敬请期待。</p></div>
    )
  }
</BaseLayout>
