---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data, id }) => !data.draft && !id.startsWith('en/')))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout title="博客 - 青鸟（Qingniao）" description="青鸟（Qingniao）的博客文章列表">
  <div style="display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-bottom: 1.5rem;">
    <h1 class="section-title" style="font-size: 1.75rem; margin: 0;">博客</h1>
    <a href="/rss.xml" title="订阅 RSS" style="display: inline-flex; align-items: center; gap: 0.4rem; color: var(--muted); font-size: 0.9rem; text-decoration: none; white-space: nowrap;">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M6.18 17.82a2.18 2.18 0 1 1 0 4.36 2.18 2.18 0 0 1 0-4.36zM4 4.44v3.13c7.01 0 12.43 5.42 12.43 12.43h3.13C19.56 10.24 12.76 4.44 4 4.44zm0 6.26v3.13c4.02 0 7.14 3.12 7.14 7.14h3.13c0-5.67-4.6-10.27-10.27-10.27z"/></svg>
      <span>RSS</span>
    </a>
  </div>

  {
    posts.length > 0 ? (
      <div style="display: grid; gap: 1.25rem;">
        {posts.map((post) => (
          <article class="card">
            <a href={`/blog/${post.id}/`} style="font-size: 1.15rem; font-weight: 700; color: var(--fg);">
              {post.data.title}
            </a>
            <div style="color: var(--muted); font-size: 0.9rem; margin-top: 0.4rem;">
              {post.data.pubDate.toLocaleDateString('zh-CN')}
              {post.data.tags.length > 0 && ` · ${post.data.tags.join(' / ')}`}
            </div>
            {post.data.description && (
              <p style="color: var(--muted); margin: 0.6rem 0 0; font-size: 0.95rem;">
                {post.data.description}
              </p>
            )}
          </article>
        ))}
      </div>
    ) : (
      <div class="card"><p style="color: var(--muted); margin: 0;">还没有文章，敬请期待。</p></div>
    )
  }
</BaseLayout>
