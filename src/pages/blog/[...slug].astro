---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data, id }) => !data.draft && !id.startsWith('en/'));
  const enSlugs = new Set(
    (await getCollection('blog', ({ data, id }) => !data.draft && id.startsWith('en/'))).map((p) => p.id.replace(/^en\//, ''))
  );
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post, hasEn: enSlugs.has(post.id) },
  }));
}

const { post, hasEn = false } = Astro.props;
const { Content } = await render(post);
const { title, description, pubDate, updatedDate, tags } = post.data;
const pageUrl = new URL(Astro.url.pathname, Astro.site);
const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description ?? undefined,
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate ?? pubDate).toISOString(),
  inLanguage: 'zh-CN',
  author: { '@type': 'Organization', name: '青鸟 Qingniao', url: 'https://qingniao.dev/about/' },
  publisher: { '@type': 'Organization', name: '青鸟 Qingniao', url: 'https://qingniao.dev' },
  mainEntityOfPage: pageUrl,
});
---

<BaseLayout title={`${title} - 青鸟（Qingniao）`} description={description} hreflang={hasEn} jsonLd={jsonLd}>
  <article>
    <header style="margin-bottom: 2rem;">
      <h1 style="font-size: 1.9rem; margin: 0 0 0.75rem; line-height: 1.3;">{title}</h1>
      <div style="color: var(--muted); font-size: 0.875rem;">
        发布于 {pubDate.toLocaleDateString('zh-CN')}
        {updatedDate && ` · 更新于 ${updatedDate.toLocaleDateString('zh-CN')}`}
        {tags.length > 0 && ` · ${tags.join(' / ')}`}
      </div>
    </header>
    <div class="prose">
      <Content />
    </div>
    <p style="margin-top: 3rem; color: var(--muted); font-size: 0.875rem;">
      <a href="/blog/">← 返回博客列表</a>
    </p>
  </article>
</BaseLayout>

<style is:global>
  .prose { font-size: 1rem; }
  .prose h2 { font-size: 1.4rem; margin-top: 2rem; }
  .prose h3 { font-size: 1.2rem; margin-top: 1.5rem; }
  .prose pre {
    background: #f6f8fa;
    padding: 1rem;
    border-radius: 6px;
    overflow-x: auto;
    font-size: 0.875rem;
  }
  .prose code {
    background: #f6f8fa;
    padding: 0.15rem 0.35rem;
    border-radius: 4px;
    font-size: 0.875rem;
  }
  .prose pre code { background: none; padding: 0; }
  .prose img { max-width: 100%; height: auto; border-radius: 6px; }
  .prose blockquote {
    border-left: 4px solid var(--border);
    margin-left: 0;
    padding-left: 1rem;
    color: var(--muted);
  }
  .prose table { border-collapse: collapse; width: 100%; }
  .prose th, .prose td { border: 1px solid var(--border); padding: 0.4rem 0.6rem; }
</style>
