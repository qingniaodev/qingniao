---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Search - Qingniao" description="Search across all posts and pages on qingniao.dev">
  <div data-pagefind-ignore>
    <h1 class="section-title" style="font-size: 1.75rem;">Search</h1>
    <p style="color: var(--muted); margin-top: 0;">Search across all posts and pages.</p>
    <div id="search" style="margin-top: 1.5rem;"></div>
  </div>

  <link rel="stylesheet" href="/pagefind/pagefind-ui.css" />
  <style>
    /* 固定搜索框宽度，避免随结果出现/消失而变来变去 */
    #search .pagefind-ui,
    #search .pagefind-ui__form,
    #search .pagefind-ui__search-input {
      width: 100% !important;
      max-width: 100% !important;
    }
    #search .pagefind-ui__search-input {
      flex: none !important;
    }
    /* drawer 竖排：结果区换到搜索框下方整行，不再横向挤压 form */
    #search .pagefind-ui__drawer {
      display: block !important;
    }
    #search .pagefind-ui__results-area {
      width: 100% !important;
      min-width: 0 !important;
      flex: none !important;
    }
  </style>
  <script is:inline>
    import('/pagefind/pagefind-ui.js').then(() => {
      const ui = new window.PagefindUI({
        element: '#search',
        showSubResults: false,
        showImages: false,
        selected_filters: { lang: ['en'] },
        translations: {
          placeholder: 'Type to search…',
          zero_results: 'No results found',
          clear_search: 'Clear',
          search: 'Search',
        },
      });
    });
  </script>
</BaseLayout>
