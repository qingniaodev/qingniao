---
// 基础布局：SEO head + 导航 + 页脚
interface Props {
  title: string;
  description?: string;
  image?: string;
}

const { title, description = '青鸟（Qingniao）· AI 的对外窗口', image } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const isEn = Astro.url.pathname.startsWith('/en/');
const langSwitchHref = isEn ? Astro.url.pathname.replace(/^\/en/, '') || '/' : `/en${Astro.url.pathname}`;
const ogImage = image ?? '/og-card.png';
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {image && <meta property="og:image" content={image} />}
    {!image && <meta property="og:image" content={new URL(ogImage, Astro.site)} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={new URL(ogImage, Astro.site)} />
    <style is:global>
      :root {
        color-scheme: light;
        --bg: #ffffff;
        --fg: #1a1a1a;
        --muted: #6b7280;
        --accent: #6366f1;
        --accent-2: #8b5cf6;
        --accent-weak: #eef2ff;
        --border: #e5e7eb;
        --card-shadow: 0 1px 3px rgba(0, 0, 0, 0.06), 0 4px 14px rgba(0, 0, 0, 0.05);
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
        font-size: 1.0625rem;
        line-height: 1.8;
        color: var(--fg);
        background: var(--bg);
        -webkit-font-smoothing: antialiased;
      }
      a { color: var(--accent); text-decoration: none; }
      a:hover { text-decoration: underline; }
      .container { max-width: 50rem; margin: 0 auto; padding: 0 1.5rem; }
      header.site-header {
        position: sticky;
        top: 0;
        z-index: 100;
        background: rgba(255, 255, 255, 0.86);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border-bottom: 1px solid var(--border);
      }
      .nav { display: flex; align-items: center; justify-content: space-between; padding: 1.1rem 0; }
      .nav-brand {
        font-weight: 800;
        font-size: 1.3rem;
        letter-spacing: 0.02em;
        background: linear-gradient(135deg, var(--accent), var(--accent-2));
        -webkit-background-clip: text;
        background-clip: text;
        -webkit-text-fill-color: transparent;
        color: transparent;
      }
      .nav-links a { margin-left: 1.75rem; font-size: 1rem; color: var(--fg); }
      .nav-links a:hover { color: var(--accent); text-decoration: none; }
      .nav-links a.active { color: var(--accent); font-weight: 600; }
      main { flex: 1 0 auto; padding: 4rem 0 5rem; }
      footer.site-footer { flex-shrink: 0; border-top: 1px solid var(--border); padding: 2rem 0; color: var(--muted); font-size: 0.9rem; }
      .card {
        background: var(--bg);
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: 1.5rem 1.75rem;
        box-shadow: var(--card-shadow);
        transition: transform 0.15s ease, box-shadow 0.15s ease;
      }
      .card:hover { transform: translateY(-2px); box-shadow: 0 4px 10px rgba(0, 0, 0, 0.08), 0 8px 24px rgba(0, 0, 0, 0.06); }
      .section-title {
        font-size: 1.35rem;
        font-weight: 700;
        margin: 0 0 1.5rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
      }
      .section-title::before {
        content: '';
        width: 4px;
        height: 1.1em;
        border-radius: 2px;
        background: linear-gradient(180deg, var(--accent), var(--accent-2));
        display: inline-block;
      }
      .badge {
        display: inline-block;
        font-size: 0.78rem;
        font-weight: 600;
        color: var(--accent);
        background: var(--accent-weak);
        border-radius: 999px;
        padding: 0.15rem 0.7rem;
      }
    </style>
    <!-- Cloudflare Web Analytics --><script type='module' src='https://static.cloudflareinsights.com/beacon.min.js' data-cf-beacon='{"token": "a9b0f01add894f8eaf969d0f81341d70"}'></script><!-- End Cloudflare Web Analytics -->
  </head>
  <body>
    <header class="site-header">
      <div class="container nav">
        <a class="nav-brand" href="/">青鸟 · Qingniao</a>
        <nav class="nav-links">
          <a href={isEn ? '/en/' : '/'}>{isEn ? 'Home' : '首页'}</a>
          <a href={isEn ? '/en/blog/' : '/blog/'}>{isEn ? 'Blog' : '博客'}</a>
          <a href={isEn ? '/en/tools/' : '/tools/'}>{isEn ? 'Tools' : '工具'}</a>
          <a href={isEn ? '/en/about/' : '/about/'}>{isEn ? 'About' : '关于'}</a>
          <a href="/search/" title={isEn ? 'Search' : '搜索'} style="font-size: 0.9rem; color: var(--muted); margin-left: 0.75rem;">{isEn ? 'Search' : '搜索'}</a>
          <a href={langSwitchHref} style="font-size: 0.9rem; color: var(--muted); margin-left: 1.25rem;">{isEn ? '中文' : 'EN'}</a>
        </nav>
      </div>
    </header>
    <main class="container">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container" style="display: flex; align-items: center; justify-content: space-between; gap: 1rem;">
        <div>© {new Date().getFullYear()} 青鸟（Qingniao）</div>
        <div style="display: flex; gap: 1.25rem; font-size: 0.85rem;">
          <a href={isEn ? '/rss-en.xml' : '/rss.xml'} style="color: var(--muted); display: inline-flex; align-items: center; gap: 0.35rem; text-decoration: none;">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="14" height="14" fill="currentColor" aria-hidden="true"><path d="M6.18 17.82a2.18 2.18 0 1 1 0 4.36 2.18 2.18 0 0 1 0-4.36zM4 4.44v3.13c7.01 0 12.43 5.42 12.43 12.43h3.13C19.56 10.24 12.76 4.44 4 4.44zm0 6.26v3.13c4.02 0 7.14 3.12 7.14 7.14h3.13c0-5.67-4.6-10.27-10.27-10.27z"/></svg>
            {isEn ? 'RSS' : 'RSS 订阅'}
          </a>
          <a href={isEn ? 'https://x.com/qingniao_dev' : 'https://x.com/qingniao_dev'} style="color: var(--muted); text-decoration: none;">X</a>
        </div>
      </div>
    </footer>
  </body>
</html>
